# ==========================================
# PAWTOK - Variables de Entorno de Ejemplo
# ==========================================

# Base de Datos (MySQL Local o Aiven Cloud)
# En Aiven: jdbc:mysql://HOST:PORT/pawtok?sslmode=require
DB_URL=jdbc:mysql://localhost:3306/pawtok?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=

# Puerto del Servidor Backend (Render inyecta PORT automáticamente)
PORT=8080

# Orígenes permitidos para CORS (Separados por comas)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Almacenamiento de Imágenes en la Nube (Cloudinary)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Frontend (En frontend/.env o entorno del cliente)
VITE_API_URL=http://localhost:8080
